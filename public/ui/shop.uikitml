<style>
  .root {
    flex-direction: column;
    align-items: center;
    padding: 24;
    gap: 10;
    background-color: rgba(0, 8, 20, 0.94);
    border-radius: 14;
    width: 420;
    border-color: rgba(255, 170, 0, 0.5);
    border-width: 2;
  }
  .title {
    font-size: 24;
    color: #ffaa00;
  }
  .gold {
    font-size: 20;
    color: #ffdd00;
  }
  .divider {
    width: 380;
    height: 1;
    background-color: rgba(255, 170, 0, 0.2);
  }
  .upgrade-row {
    flex-direction: row;
    gap: 8;
    align-items: center;
    width: 380;
    justify-content: space-between;
  }
  .upgrade-info {
    font-size: 12;
    color: rgba(0, 200, 255, 0.8);
  }
  .upgrade-label {
    font-size: 14;
    color: #00ffff;
  }
  .btn {
    padding: 8;
    background-color: rgba(255, 170, 0, 0.15);
    border-radius: 6;
    width: 100;
    align-items: center;
    cursor: pointer;
    border-color: rgba(255, 170, 0, 0.4);
    border-width: 1;
  }
  .btn-continue {
    padding: 10;
    background-color: rgba(0, 150, 200, 0.2);
    border-radius: 8;
    width: 280;
    align-items: center;
    cursor: pointer;
    border-color: rgba(0, 255, 255, 0.4);
    border-width: 1;
  }
  .btn-text {
    font-size: 14;
    color: #ffaa00;
  }
  .btn-text-continue {
    font-size: 16;
    color: #00ffff;
  }
</style>
<Panel class="root">
  <div class="title">HARBOR SHOP</div>
  <div class="gold" id="shop-gold">Gold: 0</div>
  <div class="divider"></div>
  <div class="upgrade-row">
    <div class="upgrade-label">CANNONS</div>
    <div class="upgrade-info" id="shop-cannon-info">Lv1 (150g)</div>
    <div class="btn" id="btn-upgrade-cannons"><div class="btn-text">UPGRADE</div></div>
  </div>
  <div class="upgrade-row">
    <div class="upgrade-label">HULL</div>
    <div class="upgrade-info" id="shop-hull-info">Lv1 (150g)</div>
    <div class="btn" id="btn-upgrade-hull"><div class="btn-text">UPGRADE</div></div>
  </div>
  <div class="upgrade-row">
    <div class="upgrade-label">SPEED</div>
    <div class="upgrade-info" id="shop-speed-info">Lv1 (150g)</div>
    <div class="btn" id="btn-upgrade-speed"><div class="btn-text">UPGRADE</div></div>
  </div>
  <div class="upgrade-row">
    <div class="upgrade-label">REPAIR</div>
    <div class="upgrade-info" id="shop-repair-info">HP: 100/100 (50g)</div>
    <div class="btn" id="btn-repair"><div class="btn-text">REPAIR</div></div>
  </div>
  <div class="divider"></div>
  <div class="btn-continue" id="btn-shop-continue">
    <div class="btn-text-continue">NEXT WAVE</div>
  </div>
</Panel>
